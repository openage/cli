{
    "items": [
        {
            "code": "fetch-composer-task-templates",
            "name": "Fetch composer task templates",
            "disabled": true,
            "type": "pull",
            "config": {
                "remote": {
                    "type": "search",
                    "config": {
                        "service": "composer",
                        "collection": "task-templates"
                    }
                },
                "transforms": [
                    "remove-id"
                ]
            }
        },
        {
            "code": "fetch-connect-providers",
            "name": "Fetch connect providers",
            "disabled": false,
            "type": "pull",
            "config": {
                "remote": "search://connect/providers",
                "transforms": [
                    "remove-id"
                ]
            }
        },
        {
            "code": "fetch-connect-integrations",
            "name": "Fetch connect integrations",
            "disabled": false,
            "type": "pull",
            "config": {
                "remote": {
                    "service": "connect",
                    "endpoint": {
                        "collection": "integrations",
                        "type": "search"
                    }
                },
                "transforms": [
                    {
                        "type": "modify-property",
                        "config": {
                            "remove": [
                                "id"
                            ]
                        }
                    }
                ]
            }
        }
    ]
