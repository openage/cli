{
  "name": "@open-age/cli",
  "version": "2.4.0",
  "displayName": "OA CLI",
  "description": "Command line client to connect to open-age backend",
  "publisher": "sunny-parkash",
  "icon": "images/logo_128.png",
  "main": "./index.js",
  "type": "module",
  "scripts": {
    "lint": "eslint . --fix",
    "build:win": "node scripts/build-win.mjs",
    "build:linux": "node build.js --platform linux",
    "build:mac": "node build.js --platform macos",
    "bundle": "ncc build  index.js -o dist",
    "test": "tests/cli.js",
    "cli": "node index.js"
  },
  "engines": {
    "node": ">=20.1.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/openage/cli.git"
  },
  "keywords": [
    "open-age",
    "tools",
    "cli",
    "client"
  ],
  "bin": {
    "oa": "index.js"
  },
  "author": "Open Age Team",
  "license": "MIT",
  "dependencies": {
    "@inquirer/prompts": "^8.1.0",
    "ajv": "^8.17.1",
    "axios": "^1.13.2",
    "build-url": "^6.0.1",
    "chalk": "^5.6.2",
    "clear": "^0.1.0",
    "cli-table3": "^0.6.5",
    "colors": "^1.4.0",
    "commander": "^14.0.2",
    "config": "^4.1.1",
    "figlet": "^1.9.4",
    "form-data": "^4.0.5",
    "handlebars": "^4.7.8",
    "moment": "^2.30.1",
    "moment-timezone": "^0.6.0",
    "open": "^11.0.0",
    "winston": "^3.19.0",
    "yargs": "^18.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.2",
    "@stylistic/eslint-plugin": "^5.6.1",
    "@types/mocha": "^10.0.10",
    "@types/node": "^22.19.3",
    "@types/vscode": "^1.107.0",
    "@vscode/test-cli": "^0.0.12",
    "@vscode/test-electron": "^2.5.2",
    "eslint": "^9.39.2",
    "postject": "^1.0.0-alpha.6"
  }
}