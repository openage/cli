{
  "name": "@open-age/cli",
  "version": "2.1.0",
  "description": "client to connect to open-age backend",
  "main": "index.js",
  "scripts": {
    "cli": "node index.js",
    "build:win": "node build.js --platform win",
    "build:linux": "node build.js --platform linux",
    "build:mac": "node build.js --platform macos",
    "bundle": "ncc build  index.js -o dist",
    "test": "tests/cli.js",
    "lint": "./node_modules/.bin/eslint . --fix --ignore-pattern 'config/'"
  },
  "pkg": {
    "scripts": [
      "index.js"
    ],
    "assets": [
      "data/**/*",
      "config/**/*",
      "bin/**/*",
      "node_modules/inquirer/**/*",
      "node_modules/figlet/fonts/Standard.flf",
      "node_modules/axios/dist/node/axios.cjs"
    ],
    "targets": [],
    "outputPath": "dist"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/openage/cli.git"
  },
  "keywords": [
    "open-age",
    "cli",
    "client"
  ],
  "bin": {
    "oa": "index.js"
  },
  "author": "Open Age Team",
  "license": "MIT",
  "dependencies": {
    "@open-age/client": "^1.2.4",
    "@open-age/logger": "^1.4.0",
    "app-root-path": "^3.1.0",
    "axios": "^0.26.1",
    "build-url": "^6.0.1",
    "chalk": "^4.1.2",
    "clear": "^0.1.0",
    "cli": "^1.0.1",
    "clui": "^0.3.6",
    "colors": "^1.4.0",
    "commander": "^12.1.0",
    "config": "^3.3.12",
    "figlet": "^1.8.0",
    "handlebars": "^4.7.8",
    "inquirer": "^8.2.4",
    "inquirer-fuzzy-path": "2.3.0",
    "inquirer-select-directory": "^1.2.0",
    "jsonfile": "^6.1.0",
    "lodash": "^4.17.21",
    "moment": "^2.30.1",
    "moment-timezone": "^0.5.46",
    "node-rest-client-promise": "^3.1.1",
    "open": "^10.1.0",
    "readline": "^1.3.0",
    "validator": "6.0.0",
    "yargs": "^17.7.2"
  },
  "devDependencies": {
    "acorn": "^8.0.4",
    "chai": "^4.3.4",
    "colors": "^1.4.0",
    "eslint": "^9.14.0",
    "eslint-config-google": "^0.14.0",
    "eslint-config-standard": "^17.1.0",
    "eslint-plugin-import": "^2.31.0",
    "eslint-plugin-node": "^11.1.0",
    "eslint-plugin-promise": "^7.1.0",
    "eslint-plugin-standard": "^5.0.0",
    "jsonfile": "^6.1.0",
    "mocha": "^10.8.2",
    "sinon": "^19.0.2",
    "sinon-mongoose": "^2.3.0"
  }
}